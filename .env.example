# Bind locally by default. Put a reverse proxy in front only if remote access is needed.
MUST_DASH_HOST=127.0.0.1
MUST_DASH_PORT=8090

# The stable by-id path survives ttyUSB numbering changes.
MUST_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
MUST_SLAVE_ID=4
MUST_BAUDRATE=19200

# Read the device often, persist one sample per minute, refresh read-only config every five minutes.
MUST_POLL_INTERVAL=15
MUST_SAMPLE_INTERVAL=60
MUST_CONFIG_INTERVAL=300
MUST_SERIAL_TIMEOUT=2.5
MUST_INTER_REQUEST_DELAY=0.5
MUST_RETENTION_DAYS=730

# Relative paths are resolved from the project root.
# MUST_DB_PATH=data/inverter.sqlite3
