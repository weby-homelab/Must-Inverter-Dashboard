# Bind locally by default. For Tailscale-only access, set this to this node's 100.x IPv4 address.
# Do not use 0.0.0.0 unless an explicit firewall policy protects the service.
MUST_DASH_HOST=127.0.0.1
MUST_DASH_PORT=8090

# The stable by-id path survives ttyUSB numbering changes.
MUST_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
MUST_SLAVE_ID=4
MUST_BAUDRATE=19200

# Read the device and refresh the dashboard every ten seconds. Persist one sample per minute.
MUST_POLL_INTERVAL=10
MUST_SAMPLE_INTERVAL=60
MUST_CONFIG_INTERVAL=300
MUST_SERIAL_TIMEOUT=2.5
MUST_INTER_REQUEST_DELAY=0.5
MUST_RETENTION_DAYS=730

# Relative paths are resolved from the project root.
# MUST_DB_PATH=data/inverter.sqlite3

# Opt-in inverter write control (strictly disabled by default).
# Keep false unless running on loopback or Tailscale-only bind.
MUST_ENABLE_WRITE=false
MUST_WRITE_UNLOCK_TTL=300
MUST_WRITE_COOLDOWN=3.0
MUST_MAX_WRITES_PER_HOUR=30

# Optional Telegram outage & safety alerts (disabled by default).
# MUST_TELEGRAM_ENABLED=false
# MUST_TELEGRAM_BOT_TOKEN=
# MUST_TELEGRAM_CHAT_ID=
# MUST_ALERT_LOW_BATTERY_V=24.6
# MUST_ALERT_COOLDOWN_SECONDS=900
